ANTHROPIC_API_KEY=your-key-here
ARCHITECT_MODEL=claude-sonnet-5-5
ARCHITECT_MAX_REVIEW_ROUNDS=2
ARCHITECT_APPROVAL_SCORE=7
ARCHITECT_LLM_TIMEOUT_S=90
ARCHITECT_LLM_MAX_ATTEMPTS=3
ARCHITECT_LOG_LEVEL=INFO
# Set to true to run without an API key (returns a canned demo design)
ARCHITECT_USE_MOCK=false
